# Copy to .env.local. These values are public (they ship to the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID=4soc9l4l
NEXT_PUBLIC_SANITY_DATASET=production

# Contact form (server-only, keep secret). Create the key at resend.com → API Keys.
# CONTACT_TO_EMAIL must be the address the Resend account was created with
# until a custom domain is verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
